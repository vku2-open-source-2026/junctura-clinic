# Optional overrides. For the local demo none are needed: the server reads the
# credentials file that `npm run demo:setup` (junctura-health) wrote for this app.
# Real environment variables win over that file. Never commit a real .env.

# Where the junctura-health checkout lives (seed data and demo credentials).
# JUNCTURA_HEALTH_DIR=../junctura-health

# Use another credentials file instead of <JUNCTURA_HEALTH_DIR>/.junctura/demo/junctura-clinic.env
# JUNCTURA_CLINIC_ENV=

# Public values of the Junctura identity provider and this app's browser (PKCE) client.
# JUNCTURA_ISSUER=http://localhost:8080/identity/realms/junctura
# JUNCTURA_WEB_CLIENT_ID=health-clinic-web

# Listening address. The default port 5181 is the one registered for the browser client.
# PORT=5181
# HOST=127.0.0.1

# Offering capabilities to other apps (the Junctura calls Clinic over HTTPS).
# JUNCTURA_URL, JUNCTURA_APP_CLIENT_ID and JUNCTURA_APP_CLIENT_SECRET come from the demo credentials file.
# The certificate and key are made with `npm run provider:pki -- clinic` in junctura-dxos.
# PROVIDER_TLS_CERT=
# PROVIDER_TLS_KEY=
# PROVIDER_PORT=8443
# PROVIDER_BIND=127.0.0.1
