{
  "name": "junctura-clinic",
  "version": "0.1.0",
  "private": true,
  "description": "Junctura Clinic: commune health station app on Junctura DX-OS (patient records from synthetic data, Junctura sign-in).",
  "license": "Apache-2.0",
  "type": "module",
  "homepage": "https://junctura.studio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vku2-open-source-2026/junctura-clinic.git"
  },
  "bugs": {
    "url": "https://github.com/vku2-open-source-2026/junctura-clinic/issues"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node server/main.mjs",
    "dev": "npm --prefix web run dev",
    "dev:server": "node server/main.mjs --port 5191",
    "build": "npm --prefix web run build",
    "web:install": "npm --prefix web ci",
    "web:test": "npm --prefix web test",
    "check": "node scripts/check.mjs",
    "check:reuse": "node scripts/check-reuse.mjs",
    "test": "node --test \"tests/*.test.mjs\""
  },
  "dependencies": {
    "@junctura/health-contracts": "^1.1.0",
    "@junctura/server-client": "^0.1.0"
  }
}
